    "## Part 4: Benchmark Architecture Portfolio & Baseline Registration\n",
    "Inspect the 13 models registered for empirical comparison:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "import os\n",
    "from pathlib import Path\n",
    "\n",
    "# Safeguard path registration\n",
    "for path_candidate in [Path.cwd(), Path(\"/kaggle/working/Intelligent-AML\")]:\n",
    "    if str(path_candidate) not in sys.path and path_candidate.exists():\n",
    "        sys.path.insert(0, str(path_candidate))\n",
    "\n",
    "from scripts.run_automated_paper_benchmark import ALL_MODELS_REGISTRY\n",
    "import pandas as pd\n",
    "\n",
    "models_df = pd.DataFrame([\n",
    "    {\n",
    "        \"Model Index\": i + 1,\n",
    "        \"Architecture Name\": m[\"name\"],\n",
    "        \"Category\": m[\"category\"],\n",
    "        \"Literature Reference\": m[\"paper_ref\"],\n",
    "        \"Slug\": m[\"slug\"]\n",
    "    }\n",
    "    for i, m in enumerate(ALL_MODELS_REGISTRY)\n",
    "])\n",
    "\n",
    "display(models_df)"
   ]
  },
