   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 3: Codebase Setup & Dataset Mounting\n",
    "Sets up the working directory and automatically configures `sys.path` so all modules can be imported seamlessly."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import os\n",
    "import sys\n",
    "import shutil\n",
    "from pathlib import Path\n",
    "\n",
    "# 1. Define canonical workspace directory\n",
    "repo_dir = Path(\"/kaggle/working/Intelligent-AML\").resolve()\n",
    "repo_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "# 2. Check if codebase was uploaded inside Kaggle dataset payload\n",
    "kaggle_input = Path(\"/kaggle/input\")\n",
    "code_found = False\n",
    "\n",
    "for p in kaggle_input.rglob(\"code\"):\n",
    "    if (p / "scripts" / "run_automated_paper_benchmark.py").exists():\n",
    "        print(f\"✓ Loading codebase directly from Kaggle input: {p}\")\n",
    "        for item in [\"src\", \"comparing_models\", \"scripts\", \"configs\"]:\n",
    "            src_item = p / item\n",
    "            dst_item = repo_dir / item\n",
    "            if src_item.exists():\n",
    "                shutil.copytree(src_item, dst_item, dirs_exist_ok=True)\n",
    "        code_found = True\n",
    "        break\n",
    "\n",
    "# 3. Fallback: Clone from GitHub if not found in dataset payload\n",
    "if not code_found and not (repo_dir / \"scripts\" / \"run_automated_paper_benchmark.py\").exists():\n",
    "    print(\"Cloning latest code from GitHub...\")\n",
    "    !git clone https://github.com/NazmulHasanNihal/Intelligent-AML.git /kaggle/working/Intelligent-AML\n",
    "\n",
    "# 4. CRITICAL: Add repo_dir to Python sys.path so imports ALWAYS succeed\n",
    "os.chdir(str(repo_dir))\n",
    "if str(repo_dir) not in sys.path:\n",
    "    sys.path.insert(0, str(repo_dir))\n",
    "if str(repo_dir / \"scripts\") not in sys.path:\n",
    "    sys.path.insert(0, str(repo_dir / \"scripts\"))\n",
    "\n",
    "# 5. Mount datasets\n",
    "target_graph_dir = repo_dir / \"data\" / \"outputs\" / \"graph_data\"\n",
    "target_graph_dir.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "for p in kaggle_input.rglob(\"graph_data\"):\n",
    "    if p.is_dir():\n",
    "        print(f\"Found datasets at: {p}\")\n",
    "        for ds in p.iterdir():\n",
    "            if ds.is_dir():\n",
    "                dst = target_graph_dir / ds.name\n",
    "                if not dst.exists():\n",
    "                    shutil.copytree(ds, dst)\n",
    "        break\n",
    "\n",
    "# 6. Restore prior checkpoints\n",
    "for p in kaggle_input.rglob(\"benchmarks\"):\n",
    "    if p.is_dir():\n",
    "        print(f\"Found prior checkpoints at: {p}\")\n",
    "        shutil.copytree(p, repo_dir / \"results\" / \"benchmarks\", dirs_exist_ok=True)\n",
    "        break\n",
    "\n",
    "print(f\"\\n✓ Active Working Directory: {os.getcwd()}\")\n",
    "print(f\"✓ sys.path[0]: {sys.path[0]}\")\n",
    "print(f\"✓ Environment successfully configured!\")"
   ]
  },
  {
   "cell_type": "markdown",
