# =============================================================================
# Intelligent-AML Enterprise Platform — Environment Configuration Template
# =============================================================================
# COPY THIS FILE TO '.env' AND FILL IN YOUR SECRETS BEFORE LAUNCHING.
# NEVER COMMIT THE REAL '.env' FILE TO VERSION CONTROL.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Core Application & Server Runtime
# -----------------------------------------------------------------------------
PORT=8000
ENVIRONMENT=development
LOG_FORMAT=console
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# -----------------------------------------------------------------------------
# 2. Relational & Audit Database (PostgreSQL 16)
# -----------------------------------------------------------------------------
# Note: In production, database credentials must NEVER be hardcoded.
POSTGRES_USER=aml_admin
POSTGRES_PASSWORD=replace_with_strong_random_db_password
POSTGRES_DB=intelligent_aml
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://aml_admin:replace_with_strong_random_db_password@postgres:5432/intelligent_aml

# -----------------------------------------------------------------------------
# 3. Cryptographic Authentication & Role-Based Access Control (RBAC)
# -----------------------------------------------------------------------------
# REQUIRED: Cryptographic HMAC-SHA256 signing secret for JWT access tokens.
# Must be at least 32 cryptographically random bytes (e.g. `openssl rand -hex 32`).
JWT_SECRET_KEY=replace_with_cryptographically_secure_random_key_min_32_bytes
JWT_EXPIRE_MINUTES=1440
AML_AUTH_ENFORCED=true
AML_PASSWORD_SALT=replace_with_cryptographically_random_password_salt

# Enable demo token dispenser endpoint (/api/v1/auth/demo-tokens).
# MUST BE SET TO 'false' IN PRODUCTION ENVIRONMENTS.
AML_ENABLE_DEMO_TOKENS=false

# -----------------------------------------------------------------------------
# 4. Enterprise Seed User Credentials
# -----------------------------------------------------------------------------
# Set initial strong passwords for administrative and analyst personas.
AML_COMPLIANCE_PASSWORD=replace_with_strong_compliance_officer_password
AML_INVESTIGATOR_PASSWORD=replace_with_strong_investigator_password
AML_AUDITOR_PASSWORD=replace_with_strong_auditor_password
AML_ADMIN_PASSWORD=replace_with_strong_admin_password

# -----------------------------------------------------------------------------
# 5. Institutional Hardware Security Module (HSM) PKI Signer
# -----------------------------------------------------------------------------
HSM_PRIVATE_KEY_SEED=replace_with_fips_140_hsm_private_seed
HSM_CERT_SUBJECT_DN="CN=Intelligent-AML Central Signatory, OU=Financial Crime Compliance, O=Interbank Clearing Authority, C=BD"
HSM_CERT_ISSUER_DN="CN=Bangladesh Bank Root PKI Authority, O=Central Bank, C=BD"
HSM_CERT_SERIAL=0x4892A81B8823EBLB
HSM_KEY_SLOT="HSM-SLOT-01 (FIPS 140-2 Level 3 Hardware Token)"

# -----------------------------------------------------------------------------
# 6. Third-Party AI & Agentic LLM Services (Optional / Prototyping)
# -----------------------------------------------------------------------------
# OpenAI API Key (Required only for CrewAI / LangChain SAR agent prototyping)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Kaggle Automation Keys (Alternative to ~/.kaggle/kaggle.json)
KAGGLE_USERNAME=your_kaggle_username_here
KAGGLE_KEY=your_kaggle_api_key_here

# -----------------------------------------------------------------------------
# 7. Cloud Services & Third-Party APIs (Reference Policy)
# -----------------------------------------------------------------------------
# AWS Credentials (If using S3 / KMS for forensic dossier archiving)
# AWS_ACCESS_KEY_ID=your_aws_access_key_id
# AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_DEFAULT_REGION=us-east-1

# Stripe Keys (Billing / Subscription tiering)
# Rule: STRIPE_SECRET_KEY is SERVER-SIDE ONLY. Never expose in frontend!
# STRIPE_SECRET_KEY=sk_live_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...

# Supabase Keys
# Rule: SUPABASE_SERVICE_ROLE_KEY is SERVER-SIDE ONLY. Never expose to client!
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=eyJ... (Only safe client-side if RLS is enforced on ALL tables)
# SUPABASE_SERVICE_ROLE_KEY=eyJ... (Bypasses RLS - STRICTLY SERVER-SIDE ONLY)

# Notification & Communications
# SENDGRID_API_KEY=SG.your_sendgrid_key_here
# TWILIO_ACCOUNT_SID=AC_your_twilio_sid
# TWILIO_AUTH_TOKEN=your_twilio_auth_token

# -----------------------------------------------------------------------------
# 8. Streaming & Event Distribution Infrastructure
# -----------------------------------------------------------------------------
REDPANDA_BROKER=localhost:9092
FLINK_JOBMANAGER_HOST=localhost
FLINK_JOBMANAGER_PORT=8083
