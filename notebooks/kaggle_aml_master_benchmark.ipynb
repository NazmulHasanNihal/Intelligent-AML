    "else:\n",
    "    print(\"WARNING: GPU is not active! In Kaggle, go to Settings (right panel) -> Accelerator -> select 'GPU T4 x 2'.\")\n",
    "\n",
    "print(f\"Available System RAM: {psutil.virtual_memory().total / (1024**3):.2f} GB\")\n",
    "print(f\"CPU Logical Processors: {psutil.cpu_count(logical=True)}\")"
   ]
