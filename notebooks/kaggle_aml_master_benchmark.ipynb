   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Part 10: Package All Results for 1-Click Download\n",
    "Creates `/kaggle/working/intelligent_aml_benchmark_results.zip` containing every checkpoint JSON, master CSV, LaTeX table, and 300-DPI vector figure:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import zipfile\n",
    "from pathlib import Path\n",
    "from IPython.display import FileLink\n",
    "\n",
    "output_zip = Path(\"/kaggle/working/intelligent_aml_benchmark_results.zip\")\n",
    "if output_zip.exists():\n",
    "    output_zip.unlink()\n",
    "\n",
    "print(\"Packaging results into ZIP archive...\")\n",
    "with zipfile.ZipFile(output_zip, \"w\", zipfile.ZIP_DEFLATED) as zf:\n",
    "    # 1. Benchmarks checkpoints\n",
    "    for f in Path(\"results/benchmarks\").rglob(\"*\"):\n",
    "        if f.is_file():\n",
    "            zf.write(f, f.relative_to(Path.cwd()))\n",
    "            \n",
    "    # 2. Master Metrics\n",
    "    for f in Path(\"results/metrics\").rglob(\"*\"):\n",
    "        if f.is_file():\n",
    "            zf.write(f, f.relative_to(Path.cwd()))\n",
    "            \n",
    "    # 3. Generated LaTeX Tables\n",
    "    for f in Path(\"papers/IEEE_Research_Paper/tables\").rglob(\"*\"):\n",
    "        if f.is_file():\n",
    "            zf.write(f, f.relative_to(Path.cwd()))\n",
    "            \n",
    "    # 4. Generated IEEE Figures\n",
    "    for f in Path(\"papers/IEEE_Research_Paper/figures\").rglob(\"*\"):\n",
    "        if f.is_file() and f.suffix.lower() in [\".pdf\", \".png\"]:\n",
    "            zf.write(f, f.relative_to(Path.cwd()))\n",
    "            \n",
    "    # 5. Progress scorecard & report\n",
    "    for doc in [\"docs/Live_Physical_Benchmark_Progress.md\", \"docs/Paper_Empirical_Scorecard.md\"]:\n",
    "        if Path(doc).exists():\n",
    "            zf.write(Path(doc), doc)\n",
    "\n",
    "size_mb = output_zip.stat().st_size / (1024 * 1024)\n",
    "print(f\"\\n[SUCCESS] All results and publication artifacts packaged: {output_zip} ({size_mb:.2f} MB)\")\n",
    "print(\"\\nClick the link below or check the Output tab on the right to download:\")\n",
    "FileLink(str(output_zip))"
   ]
  }
